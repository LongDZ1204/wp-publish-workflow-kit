# Copy this file to projects/<client>/wp-credentials.env (one file per project).
# Replace the three example values. Never paste the password into chat or a Sheet.
# After editing, tell the agent: "Tôi đã điền key cho <client>, kiểm tra giúp tôi."
# The agent sets file mode 0600 and runs a read-only WordPress connection check.

WP_URL="https://example.com"
WP_USER="wp-publish"
WP_APP_PASS="paste-wordpress-application-password-here"
