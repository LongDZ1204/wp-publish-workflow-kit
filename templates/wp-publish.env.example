# Copy this file to .env.wp-publish at the repository root.
# Then run: chmod 600 .env.wp-publish
# The setup script sets mode 0600 automatically. Do not source this file into the shell.
# Repeat the three variables with another uppercase site token for each website.

# site: example-site
WP_EXAMPLE_SITE_URL="https://example.com"
WP_EXAMPLE_SITE_USER="wp-publish"
WP_EXAMPLE_SITE_APP_PASS="xxxx xxxx xxxx xxxx xxxx xxxx"
