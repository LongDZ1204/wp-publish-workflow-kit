# Copy this file ONCE to wp-credentials.env at the kit root.
# Keep every project's WordPress keys and optional Google Sheets service-account key here.
# Add one WP_<SITE_KEY> block per project (uppercase; replace hyphens with underscores).
# Never paste passwords or service-account JSON into chat, Sheets or Git.
# After editing, tell the agent: "Tôi đã điền key cho <site-key>, kiểm tra giúp tôi."

# site: example-site
WP_EXAMPLE_SITE_URL="https://example.com"
WP_EXAMPLE_SITE_USER="wp-publish"
WP_EXAMPLE_SITE_APP_PASS="paste-wordpress-application-password-here"

# Optional Google Sheets service-account JSON. Paste the entire JSON between triple quotes.
# Leave empty when using an already-connected Google Sheets account or no Sheet.
# Sharing one file stores the key; a Sheets adapter must still be configured to use it.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON="""
"""
